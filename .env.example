# Base de Datos PostgreSQL (Local: embedded-postgres en 5433 | Render: DATABASE_URL administrado)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/joyride?schema=public"

# Seguridad JWT y QR
JWT_SECRET="joyride-sucre-dev-jwt-secret-2026-change-in-production"
JWT_REFRESH_SECRET="joyride-sucre-dev-refresh-secret-2026-change-in-production"
HMAC_SECRET="joyride-sucre-qr-hmac-secret-2026-change-in-production"

# URLs y Entorno
NODE_ENV="development"
PORT=4000
APP_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:5173"
CORS_ORIGINS=""

# Tipo de Cambio Oficial Bs -> USD
USD_EXCHANGE_RATE=6.96

# PayPal Orders API v2 (Sandbox / Live)
PAYPAL_MODE="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""

# Gerencia y Correos Reales (SMTP Gmail App Password O Resend API — vacío = vista previa local en BD)
MANAGER_EMAIL="victor2004612@gmail.com"
RESEND_API_KEY=""
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Joy Ride Café Sucre <no-reply@joyridebol.com>"
