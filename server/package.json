{
  "name": "joyride-cafe-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npx prisma generate && tsc",
    "start": "node dist/src/index.js",
    "render:start": "npx prisma db push --accept-data-loss && npx tsx prisma/seed.ts && node dist/src/index.js",
    "db:push": "npx prisma db push",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:generate": "npx prisma generate",
    "test:e2e": "npx tsx scripts/test-e2e.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@types/nodemailer": "^8.0.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.6.0",
    "prisma": "6.19.3",
    "tsx": "^4.19.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3"
  }
}
